# ============ Veritabanı ============
# PostgreSQL (yerel) / prod'ta hosted DB adresi
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/giyim_magazasi?schema=public"

# ============ Redis (cache / session / rate limit) ============
# Yerel Windows: Memurai → redis://localhost:6379
# Prod (Vercel): Upstash → UPSTASH_REDIS_REST_URL + TOKEN
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ============ Stripe ============
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ============ NextAuth / Auth.js ============
# `npx auth secret` ile üretilebilir
AUTH_SECRET="değiştir: `npx auth secret` ile üret"
AUTH_URL="http://localhost:3000"

# ============ AI Fashion Studio ============
# Sğlayıcı seçimi: "fal" (varsayılan) veya "openrouter"
AI_PROVIDER="fal"

# --- fal.ai (FLUX.1 Dev) ---
# Kayıt: https://fal.ai → Dashboard → API Keys
# Yeni hesaplara başlangıç kredisi verilir.
FAL_KEY="fal_..."

# --- OpenRouter (Gemini 2.5 Flash Image) ---
# Görsel üretimi: google/gemini-2.5-flash-image (Nano Banana)
# Key: https://openrouter.ai/settings/keys
# NOT: Key üçüncü taraf araçla paylaşıldıysa rotasyon yap (yeni key üret).
OPENROUTER_API_KEY=""

# ============ Uygulama ============
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# SEO taban URL'i (canonical/OG/sitemap; yoksa https://lastdance.store)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Checkout open-redirect allowlist'i: virgülle ayrılmış ek origin'ler
# (varsayılan olarak NEXT_PUBLIC_APP_URL / NEXT_PUBLIC_SITE_URL zaten izinli)
ALLOWED_ORIGINS=""

# ============ Cron / arka plan ============
# Süresi dolan stok rezervasyonlarını iade eden route için Bearer token
# (Vercel Cron → https://<domain>/api/cron/release-expired)
CRON_SECRET="değiştir: uzun rastgele bir değer"
